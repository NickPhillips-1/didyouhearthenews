#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if [[ ! -d "$ROOT/scripts/control/node_modules/playwright" ]]; then
  echo "Install the driver first: npm ci --prefix scripts/control && npx --prefix scripts/control playwright install chromium" >&2
  exit 1
fi
exec node "$ROOT/scripts/control/cli.mjs" "$@"
