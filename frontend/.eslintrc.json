{
  "root": true,
  "overrides": [
    {
      "files": ["src/**/*.ts"],
      "parser": "@typescript-eslint/parser",
      "parserOptions": {
        "ecmaVersion": 2022,
        "sourceType": "module"
      },
      "plugins": ["@typescript-eslint", "@angular-eslint"]
    },
    {
      "files": ["src/app/**/*.ts"],
      "excludedFiles": [
        "src/app/story-api.service.ts",
        "src/app/app.config.ts",
        "**/*.spec.ts"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@angular/common/http",
                "message": "Use StoryApiService (frontend/src/app/story-api.service.ts). Components must not import HttpClient. Call StoryApiService.list, get, or create."
              }
            ]
          }
        ]
      }
    }
  ]
}
